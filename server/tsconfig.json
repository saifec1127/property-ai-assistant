{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "src",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": true,

    "noUncheckedIndexedAccess": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}